# GROQ_API_KEY: Required for Groq AI API calls (chatbot).
# Used ONLY server-side by the api/chat.js serverless function — never exposed to the browser bundle.
# In production, set it as an environment variable in the Vercel project settings.
# For local testing of the /api/chat endpoint, run `vercel dev` (which reads this from .env.local).
GROQ_API_KEY="MY_GROQ_API_KEY"

# RESEND_API_KEY: Required to email new leads captured by the chatbot.
# Used ONLY server-side by the api/chat.js serverless function.
RESEND_API_KEY="MY_RESEND_API_KEY"

# LEAD_EMAIL_TO: Destination email address for chatbot lead notifications.
LEAD_EMAIL_TO="freddy.mallma@2ibm.es"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
