# GEMINI_API_KEY: Required for Gemini AI API calls.
# Used ONLY server-side by the api/chat.js serverless function — never exposed to the browser bundle.
# In production, set it as an environment variable in the Vercel project settings.
# For local testing of the /api/chat endpoint, run `vercel dev` (which reads this from .env.local).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
