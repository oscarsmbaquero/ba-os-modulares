# GROQ_API_KEY: Required for Groq AI API calls (chatbot).
# Used ONLY server-side by the api/chat.js serverless function — never exposed to the browser bundle.
# In production, set it as an environment variable in the Vercel project settings.
# For local testing of the /api/chat endpoint, run `vercel dev` (which reads this from .env.local).
GROQ_API_KEY="MY_GROQ_API_KEY"

# RESEND_API_KEY: Required to send lead and contact-form emails via Resend's HTTP API.
# Used ONLY server-side by api/chat.js and api/contact.js (via api/_lib/mailer.js).
RESEND_API_KEY="MY_RESEND_API_KEY"

# RESEND_FROM: Sender address. Must be on a domain verified in Resend (Domains → 2ibm.es).
# Defaults to onboarding@resend.dev (Resend's sandbox address, only deliverable to the
# Resend account owner's own email) if unset.
RESEND_FROM="info@2ibm.es"

# LEAD_EMAIL_TO: Destination email address for chatbot lead / contact-form notifications.
LEAD_EMAIL_TO="info@2ibm.es"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
